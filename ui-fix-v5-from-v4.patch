+function hashStr(s: string): number {
+  let h = 0;
+  for (let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0;
+  return Math.abs(h);
+}
+function phase(id: string, salt: string = ""): number {
+  return ((hashStr(id + salt) % 10000) / 10000) * Math.PI * 2;
